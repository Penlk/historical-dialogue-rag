{
  "Corpus": {
    "RootPath": "data/corpus"
  },
  "Indexing": {
    "RegistryPath": "data/registry/index-registry.json",
    "LocalVectorStorePath": "data/registry/local-vector-store.json",
    "DevVectorSize": 128
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333",
    "CollectionName": "historical-dialogue-chunks-ollama",
    "VectorSize": 768,
    "Distance": "Cosine"
  },
  "Chunking": {
    "MaxChunkChars": 1600,
    "OverlapChars": 250,
    "MinChunkChars": 300
  },
  "Embeddings": {
    "Provider": "ollama",
    "BatchSize": 16,
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "nomic-embed-text",
      "Truncate": true
    }
  },
  "Answers": {
    "Provider": "ollama",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.1",
      "Temperature": 0.2,
      "NumPredict": 700
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}